# AERIS AI Environment Variables
# Copy to .env and configure as needed

# LLM API Configuration (Gemini / OpenAI compatible)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Live AQI Provider (AQICN / OpenWeather / CPCB)
WAQI_API_TOKEN=
OPENWEATHER_API_KEY=

# App Configuration
APP_ENV=development
DEBUG=True
